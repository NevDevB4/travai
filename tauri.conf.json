{
  "productName": "Travai",
  "version": "1.0.0",
  "identifier": "com.travai.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devPath": "http://localhost:5173",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "tauri": {
    "allowlist": {
      "globalShortcut": {
        "all": true
      },
      "clipboard": {
        "readText": true,
        "writeText": true
      },
      "window": {
        "all": true
      },
      "shell": {
        "open": true
      }
    }
  },
  "app": {
    "windows": [
      {
        "title": "Travai - AI Code Assistant",
        "width": 1400,
        "height": 900,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "label": "main"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "msi",
      "nsis"
    ],
    "identifier": "com.travai.app",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}
